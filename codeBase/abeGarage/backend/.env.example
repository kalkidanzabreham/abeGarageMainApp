# Copy to .env and fill in. The API refuses to start if a required value is
# missing or invalid (see config/env.js).

NODE_ENV=development
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=garagehub

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated browser origins allowed by CORS (required in production)
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (0 locally, 1 on Render)
TRUST_PROXY=0

# Failed login attempts allowed per IP per window
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# pino log level: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Seed script (npm run seed) and demo reset (npm run demo:reset).
# Both REPLACE all app data and are refused in production unless
# SEED_ALLOW_PRODUCTION=true.
# One password per seeded account. Only the Demo account (read-only) may use
# a public password. Outside production unset values default to
# GarageHub-demo-1; in production all four are required, staff passwords need
# 12+ characters and must differ from the demo password.
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_MECHANIC_PASSWORD=
SEED_DEMO_PASSWORD=
SEED_ALLOW_PRODUCTION=false
