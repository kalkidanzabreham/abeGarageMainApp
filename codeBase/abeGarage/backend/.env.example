# Copy to .env and fill in. The API refuses to start if a required value is
# missing or invalid (see config/env.js).

NODE_ENV=development
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=garagehub

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated browser origins allowed by CORS (required in production)
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (0 locally, 1 on Render)
TRUST_PROXY=0

# Failed login attempts allowed per IP per window
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# Seed script (npm run seed). Password for all demo accounts; defaults to
# GarageHub-demo-1 outside production. Seeding REPLACES all data and is
# refused in production unless SEED_ALLOW_PRODUCTION=true.
DEMO_PASSWORD=
SEED_ALLOW_PRODUCTION=false
