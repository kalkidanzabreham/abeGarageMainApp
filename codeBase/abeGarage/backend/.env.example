# Copy to .env and fill in. The API refuses to start if a required value is
# missing or invalid (see config/env.js).

NODE_ENV=development
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=garagehub

# TLS to the database (required by managed MySQL such as Aiven). The server
# certificate is always verified. DB_SSL_CA = the provider's CA certificate
# (PEM; write newlines as \n to keep it on one line).
DB_SSL=false
DB_SSL_CA=

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated browser origins allowed by CORS (required in production)
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (0 locally, 1 on Render)
TRUST_PROXY=0

# Failed login attempts allowed per IP per window
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# Smart job intake (AI drafts a job card from a complaint; a person saves it).
# AI_ENABLED=false removes the feature entirely (no /api/ai routes, no UI).
AI_ENABLED=false
# fake = keyword rules, no model (for local dev and CI)
AI_PROVIDER=fake
AI_MODEL=
# per model call; the pipeline makes at most 2 calls (one retry)
AI_TIMEOUT_MS=20000
# longer complaints are cut to this many characters and flagged "truncated"
AI_MAX_INPUT_CHARS=1000
# all users together per UTC day; when reached the feature pauses with a message
AI_DAILY_CAP=200
# per user: AI_USER_LIMIT requests per AI_USER_WINDOW_MIN minutes
AI_USER_LIMIT=10
AI_USER_WINDOW_MIN=10

# pino log level: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Seed script (npm run seed) and demo reset (npm run demo:reset).
# Both REPLACE all app data and are refused in production unless
# SEED_ALLOW_PRODUCTION=true.
# One password per seeded account. Only the Demo account (read-only) may use
# a public password. Outside production unset values default to
# GarageHub-demo-1; in production all four are required, staff passwords need
# 12+ characters and must differ from the demo password.
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_MECHANIC_PASSWORD=
SEED_DEMO_PASSWORD=
SEED_ALLOW_PRODUCTION=false
