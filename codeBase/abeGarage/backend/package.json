{
  "name": "backend",
  "version": "1.0.0",
  "description": "Abe Garage",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "test": "jest --runInBand",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint .",
    "demo:reset": "node scripts/reset-demo.js"
  },
  "author": "Hamerochu",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.3.0",
    "mysql2": "^3.12.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "uuid": "^11.1.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testTimeout": 20000,
    "collectCoverageFrom": [
      "app.js",
      "config/**/*.js",
      "controllers/**/*.js",
      "middlewares/**/*.js",
      "routes/**/*.js",
      "services/**/*.js",
      "utils/**/*.js",
      "validators/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "json-summary",
      "lcov"
    ]
  }
}
